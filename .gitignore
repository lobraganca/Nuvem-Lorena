# Variáveis de ambiente: nunca versionar chaves.
# O .env.example fica no Git; o .env com valores reais, não.
.env
.env.*
!.env.example

# Gerado por "npm run build:single" — não versionar o bundle.
avena-app.html
avena-app-fragment.html

# Screenshots e scripts de verificação ficam fora do repositório. A barra no
# início prende a regra à raiz, então as imagens de src/ e public/ continuam
# versionadas — só o que eu largo aqui para conferir é que fica de fora.
/*.png
/*.html
/*.mjs
