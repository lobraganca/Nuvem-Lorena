# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (este app usa um projeto Supabase próprio, separado do Avena).

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Opcional, se algum dia for usada no cliente (checkout Bricks/Wallet no
# navegador). Hoje o checkout é feito 100% via Edge Function no servidor.
VITE_MERCADOPAGO_PUBLIC_KEY=

# Estas NÃO vão no .env do frontend — são secrets das Edge Functions,
# configuradas com `supabase secrets set` (ver README).
# MP_ACCESS_TOKEN=
# PUBLIC_APP_URL=
