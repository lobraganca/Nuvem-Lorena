<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        SEM ESTA LINHA O AVISO DE VAGA NUNCA CHEGA NO ANDROID 13 OU MAIS NOVO.

        A partir do Android 13 (API 33) mostrar notificação exige uma
        permissão que a pessoa concede, e permissão que não está declarada
        aqui não pode ser pedida: o `requestPermissions()` do app volta
        "negado" na hora, sem nunca abrir a caixa de diálogo.

        O sintoma engana. Não há erro, não há tela quebrada — a pessoa toca
        em "Avisar no celular", o app responde que não deu, e quem for
        investigar vai olhar o Firebase, a chave, o servidor. A causa está
        neste arquivo, e ela vale para a maioria dos aparelhos em uso.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
