# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor
capacitor-cordova-android-plugins

# Copied web assets
#
# Esta pasta é a saída do build (`npm run build` + `npx cap sync`), e fica
# FORA do git.
#
# Ela já esteve versionada, com uma razão que era boa e deixou de valer: o
# caminho de publicação era baixar o ZIP do GitHub e abrir a pasta no
# Android Studio, de um tablet, sem terminal. Ignorada, ela não vinha no
# ZIP — e o app compilava, instalava e abria em branco, sem erro nenhum
# que explicasse por quê.
#
# Agora quem monta é o workflow, que roda o build antes de empacotar. Com
# a pasta versionada o risco se inverte, e para pior: o arquivo enviado à
# loja levaria a cópia congelada do dia em que alguém rodou `cap sync`, o
# site seguiria se atualizando e o app da Play Store mostraria a versão
# antiga — sem nada indicando isso a ninguém.
app/src/main/assets/public/

# Generated Config files
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
