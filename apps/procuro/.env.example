# Copie para .env e preencha com as chaves do projeto do procurô no
# Supabase (Settings > API). O .env não vai para o repositório.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Ver o app sem banco nenhum ---------------------------------------
# Preencha SÓ uma destas para abrir com dados de demonstração. Com ela
# definida, o app não fala com o Supabase de jeito nenhum.
#
#   EXPO_PUBLIC_DEMO=1             entra como cliente
#   EXPO_PUBLIC_DEMO=profissional  entra já cadastrado, com oportunidades
