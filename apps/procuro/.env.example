# Copie este arquivo para .env e preencha com as chaves do projeto do procurô
# no Supabase (Settings > API). O .env não vai para o repositório.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Temporário: enquanto a tela de entrar não existe, o app precisa saber de
# quem são as oportunidades que ele mostra. Sai daqui quando o login entrar.
EXPO_PUBLIC_PROFISSIONAL_DEMO=
